# Copy to `web/.env` (git-ignored) and fill in real values for local dev
# against `supabase start`, or leave unset and run with VITE_BACKEND=local
# to keep using the FastAPI dev server (`python -m upv_auto serve --demo`).

# "local" talks to the FastAPI dev server; any other value (or unset)
# defaults to the Supabase backend.
VITE_BACKEND=supabase

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sealed-box public key the browser seals UPV credentials against (base64,
# standard alphabet) and its rotation id. See design.md's "Key rotation"
# decision and `python -m upv_auto seal-keygen` (Phase 3).
VITE_SEAL_PUBLIC_KEY=your-sealed-box-public-key-base64
VITE_SEAL_KEY_ID=v1

# Pages deploy path, e.g. "/upv-auto/" (Phase 5's vite.config.ts base).
# VITE_BASE_PATH=/
